# =============================================================================
# Polaris API — 로컬 개발용 환경변수 템플릿
# =============================================================================
# 사용법
#   Windows (PowerShell):  Copy-Item .env.example .env
#   macOS / Linux:         cp .env.example .env
#
# [별도 입력] 표시 항목은 팀 리드에게 받아 .env에 직접 입력합니다.
# .env 파일은 Git에 커밋하지 마세요.
# =============================================================================

# --- 앱 기본 설정 (기본값 그대로 사용 가능) ---
APP_NAME=Polaris API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# --- [별도 입력] Supabase PostgreSQL (Session Pooler, port 5432) ---
# Supabase Dashboard → Connect → Session Pooler → URI
# SQLAlchemy 형식: postgresql+psycopg://...
# DB 비밀번호 특수문자(@, #, % 등)는 URL encoding 필요 (예: @ → %40)
DATABASE_URL=postgresql+psycopg://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# --- [별도 입력] Supabase Auth (프론트·백엔드·데모 UI 공통) ---
# Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_ANON_PUBLISHABLE_KEY

# --- [별도 입력] Upstage Solar (AI 분석 API) ---
# Upstage Console → API Keys
UPSTAGE_API_KEY=YOUR_UPSTAGE_API_KEY
UPSTAGE_BASE_URL=https://api.upstage.ai/v1
UPSTAGE_MODEL=solar-pro3

# --- AI·인증 타임아웃 (기본값 그대로 사용 가능) ---
AI_TIMEOUT_SECONDS=30
SUPABASE_AUTH_TIMEOUT_SECONDS=10

# --- AI 분석 결과 캐시 TTL (시간, 기본값 그대로 사용 가능) ---
NORTH_STAR_ANALYSIS_TTL_HOURS=24
DAILY_RECORD_ANALYSIS_TTL_HOURS=24
COMET_RECOMMENDATION_TTL_HOURS=24

# --- 기타 (기본값 그대로 사용 가능) ---
DEFAULT_TIMEZONE=Asia/Seoul

# Expo/React Native 로컬 개발 포트. 웹 데모만 쓸 경우 http://localhost:8000 추가 가능
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:8000

# 브라우저 데모 UI (/demo). 백엔드 단독 테스트 시 true 권장
ENABLE_DEMO_UI=true
